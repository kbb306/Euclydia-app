<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Euclydia" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:textViewStyle">@style/TextViewStyle</item>
        <item name="checkboxStyle">@style/CheckBoxStyle</item>
        <item name="radioButtonStyle">@style/RadioButtonStyle</item>
    </style>
    
    <style name="Theme.Euclydia" parent="Base.Theme.Euclydia" />

    <style name="TextViewStyle" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/amaticsc</item>
    </style>

    <style name="CheckBoxStyle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:fontFamily">@font/amaticsc</item>
        <item name="fontFamily">@font/amaticsc</item>
    </style>

    <style name="RadioButtonStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:fontFamily">@font/amaticsc</item>
        <item name="fontFamily">@font/amaticsc</item>
    </style>

    <style name="BaseButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/background</item>
        <item name="android:textColor">@color/black</item>
        <item name="cornerRadius">0dp</item>
        <item name="strokeWidth">3dp</item>
    </style>

    <style name="RedButton" parent="BaseButton">
        <item name="strokeColor">@color/red</item>
    </style>
    <style name="BlueButton" parent="BaseButton">
        <item name="strokeColor">@color/blue</item>
    </style>
    <style name="YellowButton" parent="BaseButton">
        <item name="strokeColor">@color/yellow</item>
    </style>
</resources>