<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/followButton"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_follow"
        app:iconTint="@color/radarGreen"
        app:layout_constraintEnd_toStartOf="@+id/shapeName"
        app:layout_constraintStart_toEndOf="@+id/checkBox"
        app:layout_constraintTop_toTopOf="parent" />

    <!--Need to add a borderline dividing the above from name sector-->

    <TextView
        android:id="@+id/shapeName"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:text="@string/no_name"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/followButton"
        app:layout_constraintEnd_toStartOf="@+id/shapeView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/shapeView"
        android:layout_width="56dp"
        android:layout_height="45dp"
        android:src="@drawable/ic_dummy_square"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/shapeName"
        app:layout_constraintBottom_toBottomOf="@id/shapeName"/>
</androidx.constraintlayout.widget.ConstraintLayout>